#!/usr/bin/env python3
import re
import os
import subprocess
import sys
import tempfile
import urllib.parse
import urllib.request
import urllib.error

BASE = "https://rigexpert.com/files/software/Antscope/antscope2formacos/"
CASK = "Casks/antscope2.rb"

# RigExpert splits AntScope2 macOS builds across two directory lines that get
# renamed independently of the app's own version (e.g. minimum-macOS bumps),
# so each line is tracked and updated separately.
LINES = {
    "SEQUOIA": ("sequoia", "From"),
    "SONOMA": ("sonoma", "Up to"),
}


def fetch(url):
    req = urllib.request.Request(url, headers={"User-Agent": "curl/7.88.1"})
    with urllib.request.urlopen(req) as r:
        return r.read().decode("utf-8")


def find_dmg(html):
    dmgs = re.findall(r'href="(AntScope2[^"]+\.dmg)"', html)
    return dmgs[0] if dmgs else None


def version_key(href):
    name = urllib.parse.unquote(href)
    m = re.search(r"(\d+(?:\.\d+)+)", name)
    return [int(x) for x in m.group(1).split(".")] if m else [0]


def latest_release(prefix, index_html):
    hrefs = re.findall(r'href="([^"]+/)"', index_html)
    dirs = sorted(
        [h for h in hrefs if urllib.parse.unquote(h).startswith(prefix)],
        key=version_key,
    )
    if not dirs:
        return None

    latest_dir = dirs[-1]
    try:
        dmg_html = fetch(BASE + latest_dir)
    except (urllib.error.URLError, urllib.error.HTTPError) as e:
        print(f"antscope2: skipping {prefix!r} line — {e}", file=sys.stderr)
        return None

    dmg = find_dmg(dmg_html)
    if not dmg:
        print(f"antscope2: skipping {prefix!r} line — could not find DMG file", file=sys.stderr)
        return None

    m = re.search(r"AntScope2_([0-9.]+)_mac\.dmg", dmg)
    return {
        "version": m.group(1) if m else "",
        "url": BASE + latest_dir + dmg,
        "dir": latest_dir.rstrip("/"),
    }


def current_branch_values(block_name, cask_text):
    """Pull version/sha256/dir out of this branch's own on_sequoia/on_sonoma block."""
    block = re.search(rf"on_{block_name}.*?\n  end\n", cask_text, re.S)
    if not block:
        return None, None, None

    body = block.group(0)
    version = re.search(r'version "([^"]+)"', body)
    sha256 = re.search(r'sha256 "([^"]+)"', body)
    dir_ = re.search(r"antscope2formacos/([^/]+)/AntScope2_", body)
    return (
        version.group(1) if version else None,
        sha256.group(1) if sha256 else None,
        dir_.group(1) if dir_ else None,
    )


try:
    index_html = fetch(BASE)
except (urllib.error.URLError, urllib.error.HTTPError) as e:
    print(f"antscope2: skipping — {e}", file=sys.stderr)
    sys.exit(0)

try:
    with open(CASK) as f:
        current_cask = f.read()
except FileNotFoundError:
    current_cask = ""

env = os.environ.copy()
any_changed = False

for env_prefix, (block_name, dir_prefix) in LINES.items():
    release = latest_release(dir_prefix, index_html)
    if release is None:
        continue

    cur_version, cur_sha256, cur_dir = current_branch_values(block_name, current_cask)

    if cur_version == release["version"] and cur_sha256:
        print(f"antscope2: {block_name} already at v{release['version']}")
        env[f"{env_prefix}_VERSION"] = cur_version
        env[f"{env_prefix}_SHA256"] = cur_sha256
        env[f"{env_prefix}_DIR"] = cur_dir or release["dir"]
        continue

    with tempfile.NamedTemporaryFile(suffix=".dmg", delete=False) as tmp:
        tmp_path = tmp.name

    try:
        result = subprocess.run(
            ["curl", "-fsSL", "--max-time", "120", release["url"], "-o", tmp_path]
        )
        if result.returncode != 0:
            print(
                f"antscope2: skipping {block_name} — download failed (exit {result.returncode})",
                file=sys.stderr,
            )
            if cur_version and cur_sha256:
                env[f"{env_prefix}_VERSION"] = cur_version
                env[f"{env_prefix}_SHA256"] = cur_sha256
                env[f"{env_prefix}_DIR"] = cur_dir or release["dir"]
            continue
        sha256 = subprocess.run(
            ["shasum", "-a", "256", tmp_path],
            capture_output=True, text=True, check=True
        ).stdout.split()[0]
    finally:
        os.unlink(tmp_path)

    env[f"{env_prefix}_VERSION"] = release["version"]
    env[f"{env_prefix}_SHA256"] = sha256
    env[f"{env_prefix}_DIR"] = release["dir"]
    any_changed = True
    print(f"antscope2: {block_name} updated to v{release['version']}")

if not any_changed:
    sys.exit(0)

with open(f"{CASK}.in") as f:
    template = f.read()

result = subprocess.run(
    ["envsubst"], input=template, capture_output=True, text=True, check=True, env=env
)
with open(CASK, "w") as f:
    f.write(result.stdout)

print("antscope2: cask updated")
