#!/usr/bin/env python3
import re
import os
import subprocess
import sys
import tempfile
import urllib.parse
import urllib.request
import urllib.error

BASE = "https://rigexpert.com/files/software/Antscope/antscope2formacos/"
CASK = "Casks/antscope2.rb"


def fetch(url):
    req = urllib.request.Request(url, headers={"User-Agent": "curl/7.88.1"})
    with urllib.request.urlopen(req) as r:
        return r.read().decode("utf-8")


def find_dmg(html):
    dmgs = re.findall(r'href="(AntScope2[^"]+\.dmg)"', html)
    return dmgs[0] if dmgs else None


def version_key(href):
    name = urllib.parse.unquote(href)
    m = re.search(r"(\d+(?:\.\d+)+)", name)
    return [int(x) for x in m.group(1).split(".")] if m else [0]


try:
    html = fetch(BASE)
except (urllib.error.URLError, urllib.error.HTTPError) as e:
    print(f"antscope2: skipping — {e}", file=sys.stderr)
    sys.exit(0)

hrefs = re.findall(r'href="([^"]+/)"', html)
latest_dirs = sorted(
    [h for h in hrefs if urllib.parse.unquote(h).startswith("From")],
    key=version_key,
)

if not latest_dirs:
    print("antscope2: skipping — could not find any 'From MacOS' directories", file=sys.stderr)
    sys.exit(0)

latest_dir = latest_dirs[-1]

try:
    dmg_html = fetch(BASE + latest_dir)
except (urllib.error.URLError, urllib.error.HTTPError) as e:
    print(f"antscope2: skipping — {e}", file=sys.stderr)
    sys.exit(0)

dmg = find_dmg(dmg_html)
if not dmg:
    print("antscope2: skipping — could not find DMG file", file=sys.stderr)
    sys.exit(0)

m = re.search(r"AntScope2_([0-9.]+)_mac\.dmg", dmg)
version = m.group(1) if m else ""
url = BASE + latest_dir + dmg

try:
    with open(CASK) as f:
        current = re.search(r'version "([^"]+)"', f.read())
    if current and current.group(1) == version:
        print(f"antscope2: already at v{version}")
        sys.exit(0)
except FileNotFoundError:
    pass

with tempfile.NamedTemporaryFile(suffix=".dmg", delete=False) as tmp:
    tmp_path = tmp.name

try:
    result = subprocess.run(
        ["curl", "-fsSL", "--max-time", "120", url, "-o", tmp_path]
    )
    if result.returncode != 0:
        print(f"antscope2: skipping — download failed (exit {result.returncode})", file=sys.stderr)
        sys.exit(0)
    sha256 = subprocess.run(
        ["shasum", "-a", "256", tmp_path],
        capture_output=True, text=True, check=True
    ).stdout.split()[0]
finally:
    os.unlink(tmp_path)

env = os.environ.copy()
env.update({"VERSION": version, "SHA256": sha256, "URL": url})

with open(f"{CASK}.in") as f:
    template = f.read()

result = subprocess.run(
    ["envsubst"], input=template, capture_output=True, text=True, check=True, env=env
)
with open(CASK, "w") as f:
    f.write(result.stdout)

print(f"antscope2: updated v{version}")
