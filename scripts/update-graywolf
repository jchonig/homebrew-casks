#!/bin/bash
set -euo pipefail

FORMULA="Formula/graywolf.rb"
REPO="chrissnell/graywolf"
TAP_FORMULA="jchonig/casks/graywolf"

export VERSION
VERSION=$(brew livecheck --formula --json "${TAP_FORMULA}" | python3 -c "import sys, json; print(json.load(sys.stdin)[0]['version']['latest'])")
TAG="v${VERSION}"

BASE_URL="https://github.com/${REPO}/releases/download/${TAG}"

ARM_TGZ=$(mktemp)
AMD_TGZ=$(mktemp)
trap 'rm -f "$ARM_TGZ" "$AMD_TGZ"' EXIT

curl -fsSL --max-time 120 -o "$ARM_TGZ" "${BASE_URL}/graywolf_${VERSION}_macOS_arm64.tar.gz"
curl -fsSL --max-time 120 -o "$AMD_TGZ" "${BASE_URL}/graywolf_${VERSION}_macOS_x86_64.tar.gz"

export ARM_SHA
export AMD_SHA
ARM_SHA=$(shasum -a 256 "$ARM_TGZ" | awk '{print $1}')
AMD_SHA=$(shasum -a 256 "$AMD_TGZ" | awk '{print $1}')

CURRENT_VERSION=$(grep -m1 'url "' "${FORMULA}" 2>/dev/null | sed -n 's#.*/v\([0-9][^/]*\)/.*#\1#p')
CURRENT_ARM_SHA=$(grep -A2 'on_arm' "${FORMULA}" 2>/dev/null | grep sha256 | awk '{print $2}' | tr -d '"' || true)

if [[ "$CURRENT_VERSION" == "$VERSION" && "$CURRENT_ARM_SHA" == "$ARM_SHA" ]]; then
    echo "graywolf: already at v${VERSION} with correct checksums"
    exit 0
fi

envsubst < "${FORMULA}.in" > "${FORMULA}"

echo "graywolf: updated to v${VERSION}"
