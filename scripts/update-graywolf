#!/bin/bash
set -euo pipefail

FORMULA="Formula/graywolf.rb"
REPO="chrissnell/graywolf"
TAP_FORMULA="jchonig/casks/graywolf"

export VERSION
VERSION=$(brew livecheck --formula --json "${TAP_FORMULA}" | python3 -c "import sys, json; print(json.load(sys.stdin)[0]['version']['latest'])")
TAG="v${VERSION}"

BASE_URL="https://github.com/${REPO}/releases/download/${TAG}"

MACOS_ARM_TGZ=$(mktemp)
MACOS_AMD_TGZ=$(mktemp)
LINUX_ARM_TGZ=$(mktemp)
LINUX_AMD_TGZ=$(mktemp)
trap 'rm -f "$MACOS_ARM_TGZ" "$MACOS_AMD_TGZ" "$LINUX_ARM_TGZ" "$LINUX_AMD_TGZ"' EXIT

curl -fsSL --max-time 120 -o "$MACOS_ARM_TGZ" "${BASE_URL}/graywolf_${VERSION}_macOS_arm64.tar.gz"
curl -fsSL --max-time 120 -o "$MACOS_AMD_TGZ" "${BASE_URL}/graywolf_${VERSION}_macOS_x86_64.tar.gz"
curl -fsSL --max-time 120 -o "$LINUX_ARM_TGZ" "${BASE_URL}/graywolf_${VERSION}_linux_arm64.tar.gz"
curl -fsSL --max-time 120 -o "$LINUX_AMD_TGZ" "${BASE_URL}/graywolf_${VERSION}_linux_x86_64.tar.gz"

export MACOS_ARM_SHA
export MACOS_AMD_SHA
export LINUX_ARM_SHA
export LINUX_AMD_SHA
MACOS_ARM_SHA=$(shasum -a 256 "$MACOS_ARM_TGZ" | awk '{print $1}')
MACOS_AMD_SHA=$(shasum -a 256 "$MACOS_AMD_TGZ" | awk '{print $1}')
LINUX_ARM_SHA=$(shasum -a 256 "$LINUX_ARM_TGZ" | awk '{print $1}')
LINUX_AMD_SHA=$(shasum -a 256 "$LINUX_AMD_TGZ" | awk '{print $1}')

CURRENT_VERSION=$(grep -m1 'url "' "${FORMULA}" 2>/dev/null | sed -n 's#.*/v\([0-9][^/]*\)/.*#\1#p')
CURRENT_MACOS_ARM_SHA=$(grep -A2 'on_arm' "${FORMULA}" 2>/dev/null | grep sha256 | head -1 | awk '{print $2}' | tr -d '"' || true)

if [[ "$CURRENT_VERSION" == "$VERSION" && "$CURRENT_MACOS_ARM_SHA" == "$MACOS_ARM_SHA" ]]; then
    echo "graywolf: already at v${VERSION} with correct checksums"
    exit 0
fi

envsubst < "${FORMULA}.in" > "${FORMULA}"

echo "graywolf: updated to v${VERSION}"
